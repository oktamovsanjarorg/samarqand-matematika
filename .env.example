# Nusxa: cp .env.example .env  (.env repoga tushmaydi)

# --- Baza ---
DATABASE_URL=postgresql://samarqand:samarqand@127.0.0.1:5435/samarqand_dev
REDIS_URL=redis://127.0.0.1:6383

# --- Telegram ---
# BotFather'dan test bot tokeni (production tokeni lokalda ishlatilmaydi)
BOT_TOKEN=
# Mini App HTTPS manzili (lokalda: cloudflared tunnel manzili)
MINIAPP_URL=https://example.trycloudflare.com
BRAND_NAME="Samarqand matematika maktabi"

# --- API ---
API_PORT=4300
JWT_SECRET=
# Ustoz(lar)ning Telegram username'lari, vergul bilan, @ siz
OWNER_USERNAMES=
# Ustoz(lar)ning Telegram ID'lari, vergul bilan (username o'zgarsa ham ishlaydi)
OWNER_TELEGRAM_IDS=
# Bot xabarlari: telegram (standart) yoki off (hech narsa yuborilmaydi; brauzer testlari shunday ishlaydi)
NOTIFY_TRANSPORT=telegram
CORS_ORIGINS=http://127.0.0.1:5190,http://127.0.0.1:5191
# AI: off (standart) | claude | deepseek. DeepSeek matnli ishlar uchun (yordamchi, admin agenti), rasm o'qimaydi
AI_PROVIDER=off
DEEPSEEK_API_KEY=
