# Hostlar .env dan keladi:
#   DOMAIN         — asosiy: Mini App, /api, /admin (app.samarqandmatematika.uz)
#   ADMIN_HOST     — admin panel uchun qisqa manzil, DOMAIN/admin/ ga yo'naltiriladi
#   REDIRECT_HOSTS — boshqa manzillar (eski sslip.io), DOMAIN ga yo'naltiriladi
#   LANDING_HOST   — sayt (T-173): statik landing, sitemap va robots; www shu yerga yo'naltiriladi
{
	# T-106: xato loglarida (stderr, docker logs) ham so'rov filtrlanadi: ?q= (ism, telefon) va IP oxiri yashirin
	log default {
		format filter {
			wrap json
			request>uri query {
				replace q REDACTED
			}
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 32
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 32
			}
		}
	}
}

# T-174: faqat mavjud /assets/* fayllari bir yilga keshlanadi. Yo'q fayl (deploydan keyin eski chunk nomi)
# index.html emas, keshsiz 404 oladi: aks holda brauzer HTML'ni JS deb oladi, oq ekran bir yil keshda qoladi.
(assets) {
	@assets {
		path /assets/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@missing_asset {
		path /assets/*
		not file
	}
	header @missing_asset Cache-Control "no-store"
	# index.html (har qanday sahifa manzilida) keshlanmaydi: deploydan keyin Telegram eski versiyani ochmasin (T-132)
	@html not path /assets/*
	header @html Cache-Control "no-cache"
}

# Router sahifalari index.html'ga tushadi, /assets/* esa hech qachon (route tartibni saqlaydi)
(spa) {
	route {
		respond @missing_asset 404
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_HOST} {
	redir https://{$DOMAIN}/admin{uri} 302
}

{$REDIRECT_HOSTS} {
	# Eski havolalar (bot xabarlari) va Telegram initData (#...) yo'qolmaydi
	redir https://{$DOMAIN}{uri} 302
}

www.{$LANDING_HOST} {
	redir https://{$LANDING_HOST}{uri} 301
}

# T-173: Google indekslaydigan sayt. Sahifalar build paytida HTML'ga aylangan (apps/landing),
# manzillar Caddy shabloni bilan qo'yiladi: {{.Host}} va {{env `DOMAIN`}}.
{$LANDING_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Frame-Options DENY
		-Server
	}

	# Bot havolasi (tugmalar) shu yerdan olinadi
	handle /api/public/* {
		reverse_proxy api:4300 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv/landing
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages path / /index.html /sitemap.html /sitemap.xml /robots.txt
		header @pages Cache-Control "no-cache"
		templates @pages {
			mime text/html text/plain application/xml text/xml
		}
		# Eski havolalar (masalan /admin) ilovaga o'tadi
		@missing not file {path} {path}/index.html
		redir @missing https://{$DOMAIN}{uri} 302
		file_server
	}
}

{$DOMAIN} {
	encode zstd gzip

	# API so'rovlari logi (T-106): deploydan keyin ham saqlanadi (caddy_data volume), 5xx xatolarni topish uchun.
	# Caddy Authorization va Cookie sarlavhalarini o'zi yashiradi; statik fayllar yozilmaydi.
	# Shaxsiy ma'lumot logga tushmaydi: qidiruvdagi ?q= (ism, telefon) yashiriladi, IP oxirgi qismisiz
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>uri query {
				replace q REDACTED
			}
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 32
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 32
			}
		}
	}
	@static not path /api/*
	log_skip @static

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:4300 {
			# API rate limit haqiqiy IP bo'yicha ishlaydi (apps/api/src/setup.ts)
			header_up X-Real-IP {remote_host}
			# T-152: deploy paytida API konteyneri qayta ishga tushguncha (migratsiya bilan bir necha soniya) so'rov kutadi,
			# foydalanuvchi 502 ko'rmaydi. Faqat ulanib bo'lmaganda qayta uriniladi: API'ga yetgan so'rov takrorlanmaydi.
			lb_try_duration 30s
			lb_try_interval 500ms
			# POST tanasi (javob, chek rasmi ≤5 MB, MAX_RECEIPT_BYTES) qayta yuborish uchun xotirada turadi
			request_buffers 6MiB
		}
	}

	# Router "/admin" ga ham o'tadi: sahifa qayta yuklanganda 404 bo'lmasin
	redir /admin /admin/ 302

	handle_path /admin/* {
		root * /srv/admin
		# T-147: admin boshqa saytda iframe ichida ochilmaydi (clickjacking) va faqat o'z fayllarini yuklaydi.
		# style 'unsafe-inline': KaTeX formulalarida style atributi. blob: — token bilan olingan chek rasmlari.
		# Mini App'ga qo'yilmaydi: uni Telegram Web iframe ichida ochadi.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
		}
		import assets
		import spa
	}

	handle {
		root * /srv/miniapp
		import assets
		import spa
	}
}
