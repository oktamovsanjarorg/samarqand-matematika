// Ma'lumotlar modeli: docs/05-data-model.md. Sxema o'zgarsa, hujjat ham shu PR'da yangilanadi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  ASSISTANT
  TEACHER
}

model User {
  id            String       @id @default(cuid())
  telegramId    BigInt       @unique
  firstName     String
  lastName      String?
  username      String?
  phone         String?
  role          Role         @default(STUDENT)
  isBlocked     Boolean      @default(false)
  blockedReason String?
  lastSeenAt    DateTime?    @db.Timestamptz
  loginTokens   LoginToken[]
  auditLogs     AuditLog[]
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  @@index([role])
}

/// Admin panelga kirish uchun bot yuboradigan bir martalik havola (5 daqiqa)
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
}

/// Kalit-qiymat sozlamalar: brend, imtihon shablonlari, limitlar (kodga qotirilmaydi)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Har bir yozish amali: kim, nima, qachon
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entity, entityId])
  @@index([createdAt])
}
