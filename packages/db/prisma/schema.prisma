// Ma'lumotlar modeli: docs/05-data-model.md. Sxema o'zgarsa, hujjat ham shu PR'da yangilanadi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  ASSISTANT
  TEACHER
}

model User {
  id                String           @id @default(cuid())
  telegramId        BigInt           @unique
  firstName         String
  lastName          String?
  username          String?
  phone             String?
  role              Role             @default(STUDENT)
  isBlocked         Boolean          @default(false)
  blockedReason     String?
  lastSeenAt        DateTime?        @db.Timestamptz
  loginTokens       LoginToken[]
  auditLogs         AuditLog[]
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz
  topicAttempts     TopicAttempt[]
  payments          Payment[]
  reviewedPayments  Payment[]        @relation("PaymentReviewer")
  subscriptions     Subscription[]
  weeklyAttempts    WeeklyAttempt[]
  weeklyReviews     WeeklyAnswer[]   @relation("WeeklyReviewer")
  student           StudentProfile?  @relation("Student")
  acceptedStudents  StudentProfile[] @relation("AcceptedBy")
  children          ParentLink[]     @relation("ParentOf")
  reviewedLinks     ParentLink[]     @relation("LinkReviewer")
  submittedPayments Payment[]        @relation("PaymentSubmitter")
  TutorChat         TutorChat[]
  mockAttempts      MockAttempt[]
  attendance        Attendance[]     @relation("Attendance")
  attendanceMarked  Attendance[]     @relation("AttendanceMarker")
  offlineTests      OfflineTest[]    @relation("OfflineTestCreator")
  offlineResults    OfflineResult[]  @relation("OfflineResults")
  trashItems        TrashItem[]      @relation("TrashDeleter")

  @@index([role])
}

/// Admin panelga kirish uchun bot yuboradigan bir martalik havola (5 daqiqa)
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
}

/// Kalit-qiymat sozlamalar: brend, imtihon shablonlari, limitlar (kodga qotirilmaydi)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Har bir yozish amali: kim, nima, qachon
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Axlat qutisi (T-099, FR-U05): o'chirilgan kontent qatorining to'liq nusxasi. TRASH_DAYS kun saqlanadi, keyin o'chadi
model TrashItem {
  id          String   @id @default(cuid())
  /// Course | Topic | Lesson | Question
  entity      String
  entityId    String
  /// Ro'yxatda ko'rsatiladigan nom (savol uchun matn boshi)
  title       String
  /// Tiklash uchun kerak ota: mavzu uchun kurs, dars va savol uchun mavzu
  parentId    String?
  /// Qatorning o'zi (Prisma qatori JSON ko'rinishida)
  data        Json
  deletedById String?
  deletedBy   User?    @relation("TrashDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime @default(now()) @db.Timestamptz

  @@index([deletedAt])
}

/// Kurs → Mavzu → Dars (docs/05-data-model.md). Tartib `order` bo'yicha, ota ichida 0 dan boshlab
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  topics      Topic[]
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([order])
}

model Topic {
  id        String         @id @default(cuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  title     String
  order     Int            @default(0)
  lessons   Lesson[]
  questions Question[]
  attempts  TopicAttempt[]
  createdAt DateTime       @default(now()) @db.Timestamptz
  updatedAt DateTime       @updatedAt @db.Timestamptz

  @@index([courseId, order])
}

model Lesson {
  id          String    @id @default(cuid())
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  title       String
  /// Konspekt: Markdown va LaTeX ($...$, $$...$$)
  body        String    @default("")
  /// Video havola (keyinroq himoyalangan HLS bilan almashtiriladi)
  videoUrl    String?
  order       Int       @default(0)
  /// Bepul dars: obunasiz ham ochiq (sinov uchun)
  isFree      Boolean   @default(false)
  isPublished Boolean   @default(false)
  /// O'quvchilarga "yangi dars" xabari yuborilgan vaqt (T-091, ustoz tugmasi bilan, bir marta)
  announcedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@index([topicId, order])
}

enum QuestionType {
  SINGLE
  MULTIPLE
  NUMERIC
  EXPRESSION
  MATCHING
  WRITTEN
}

/// Savollar banki (T-022). To'g'ri javob alohida ustunda: o'quvchiga ko'rinish tuzilganda tanlanmaydi
model Question {
  id              String           @id @default(cuid())
  topicId         String
  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Restrict)
  type            QuestionType
  /// Savol matni: Markdown va LaTeX
  text            String
  /// O'quvchi ko'radigan qism: variantlar (SINGLE, MULTIPLE) yoki ikki ustun (MATCHING)
  content         Json             @default("{}")
  /// To'g'ri javob. WRITTEN uchun null (ustoz qo'lda baholaydi)
  answer          Json?
  /// Namunaviy yechim: natijadan keyin ko'rsatiladi, AI tekshiruvida asos bo'ladi
  solution        String           @default("")
  /// 1 oson, 2 o'rta, 3 qiyin
  difficulty      Int              @default(2)
  /// Ko'nikma teglari (masalan "kvadrat-tenglama"): ko'rsatmalar uchun
  skills          String[]
  answers         TopicAnswer[]
  order           Int              @default(0)
  isPublished     Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz
  weeklyQuestions WeeklyQuestion[]
  weeklyAnswers   WeeklyAnswer[]
  tutorChats      TutorChat[]
  mockQuestions   MockQuestion[]
  mockAnswers     MockAnswer[]

  @@index([topicId, order])
}

enum CheckResult {
  CORRECT
  WRONG
  MANUAL
}

/// Mavzu testi urinishi (T-023). Mashq: qayta ishlash mumkin, vaqt server bo'yicha yoziladi
model TopicAttempt {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Restrict)
  startedAt    DateTime      @default(now()) @db.Timestamptz
  submittedAt  DateTime?     @db.Timestamptz
  /// Avtomatik tekshirilgan to'g'ri javoblar soni (MANUAL hisobga kirmaydi)
  correct      Int?
  /// Faqat xato qilingan savollar bilan qayta ishlash (T-104): statistika va tavsiyalarga kirmaydi
  mistakesOnly Boolean       @default(false)
  answers      TopicAnswer[]

  @@index([userId, topicId, submittedAt])
}

/// Urinishdagi savol: boshlanganda tanlangan savollar shu yerda muzlatiladi
model TopicAnswer {
  attemptId  String
  attempt    TopicAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  order      Int
  response   Json?
  result     CheckResult?
  updatedAt  DateTime     @updatedAt @db.Timestamptz

  @@id([attemptId, questionId])
}

/// Kirish rejimi: AUTO — BR-A04 shartlari bo'yicha; FREE — ustoz qo'lda ochib bergan; CLOSED — ustoz yopgan
enum StudentAccess {
  AUTO
  FREE
  CLOSED
}

/// O'quvchi profili (T-020). User.firstName Telegram'dan har kirishda yangilanadi, haqiqiy ism shu yerda
model StudentProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation("Student", fields: [userId], references: [id], onDelete: Cascade)
  /// O'quvchi o'zi kiritgan ism-familiya (BR-S01)
  fullName     String?
  accessMode   StudentAccess @default(AUTO)
  /// Ustoz "o'quvchim" deb qabul qilgan vaqt (BR-S03)
  acceptedAt   DateTime?     @db.Timestamptz
  acceptedById String?
  acceptedBy   User?         @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  /// Ustozga "yangi o'quvchi" xabari yuborilgan vaqt (bir marta)
  announcedAt  DateTime?     @db.Timestamptz
  /// Ota-ona botga shu kod bilan ulanadi (t.me/<bot>?start=p_<kod>)
  parentCode   String?       @unique
  parents      ParentLink[]
  /// Offline guruh (T-054)
  groupId      String?
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  @@index([acceptedAt])
  @@index([groupId])
}

enum ParentLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Ota-ona ulanishi (T-020b). Ustoz qo'ng'iroq qilib tekshiradi va tasdiqlaydi (BR-A04)
model ParentLink {
  id           String           @id @default(cuid())
  parentId     String
  parent       User             @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ParentLinkStatus @default(PENDING)
  /// Telegram tasdiqlagan raqam (request_contact)
  phone        String
  /// Ustoz uchun shubha belgilari: same_phone, parent_activity, many_children
  flags        String[]
  reviewedById String?
  reviewedBy   User?            @relation("LinkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?        @db.Timestamptz
  rejectReason String?
  createdAt    DateTime         @default(now()) @db.Timestamptz

  @@unique([parentId, studentId])
  @@index([status])
}

/// Obuna tarifi: narx va muddat ustoz tomonidan admin panelda belgilanadi
model Plan {
  id            String         @id @default(cuid())
  name          String
  priceUzs      Int
  durationDays  Int
  description   String?
  isActive      Boolean        @default(true)
  order         Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz
  payments      Payment[]
  subscriptions Subscription[]
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Qo'lda to'lov: o'quvchi kartaga o'tkazib chek rasmini yuboradi, ustoz tasdiqlaydi (BR-B01)
model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// To'lov paytidagi narx (tarif narxi keyin o'zgarishi mumkin)
  amountUzs     Int
  status        PaymentStatus @default(PENDING)
  /// MEDIA_DIR ichidagi nisbiy yo'l: receipts/<id>.jpg
  receiptPath   String?
  /// Chek rasmi baytlarining SHA-256 (T-124): bir xil chek qayta yuborilsa ustoz ogohlantiriladi
  receiptHash   String?
  payerNote     String?
  reviewedById  String?
  reviewedBy    User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?     @db.Timestamptz
  /// Chekni ota-ona yuborgan bo'lsa (T-120); null: o'quvchining o'zi
  submittedById String?
  submittedBy   User?         @relation("PaymentSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  subscription  Subscription?
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([receiptHash])
}

/// To'liq kirish davri (BR-A04 "to'lov qilingan"): endsAt > hozir bo'lsa faol
model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentId     String?  @unique
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  startsAt      DateTime @db.Timestamptz
  endsAt        DateTime @db.Timestamptz
  /// Yuborilgan eslatma (T-090): 0 yo'q, 1 "3 kun qoldi", 2 "tugadi"
  reminderStage Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz

  @@index([userId, endsAt])
}

/// Haftalik test (BR-W01): oyna opensAt..closesAt, savollar bankdan olinadi
model WeeklyTest {
  id            String           @id @default(cuid())
  title         String
  opensAt       DateTime         @db.Timestamptz
  closesAt      DateTime         @db.Timestamptz
  isPublished   Boolean          @default(false)
  /// Yuborilgan eslatma (BR-W07): 0 yo'q, 1 "24 soat qoldi", 2 "3 soat qoldi"
  reminderStage Int              @default(0)
  /// O'quvchilarga "test ochildi" xabari yuborilgan vaqt (T-080)
  announcedAt   DateTime?        @db.Timestamptz
  /// Oyna yopilib ballar qo'yilgan vaqt (BR-W03, W08)
  closedAt      DateTime?        @db.Timestamptz
  createdAt     DateTime         @default(now()) @db.Timestamptz
  questions     WeeklyQuestion[]
  attempts      WeeklyAttempt[]

  @@index([isPublished, closesAt])
}

model WeeklyQuestion {
  weeklyTestId String
  weeklyTest   WeeklyTest @relation(fields: [weeklyTestId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  order        Int

  @@id([weeklyTestId, questionId])
}

/// O'quvchining yagona urinishi (BR-W02)
model WeeklyAttempt {
  id           String         @id @default(cuid())
  weeklyTestId String
  weeklyTest   WeeklyTest     @relation(fields: [weeklyTestId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime       @default(now()) @db.Timestamptz
  submittedAt  DateTime?      @db.Timestamptz
  /// Avtomatik tekshiruvdagi to'g'ri javoblar
  correct      Int?
  /// Ball: oyna yopilganda qo'yiladi, topshirilmagan bo'lsa 0 (BR-W03). Keyin ustoz o'zgartiradi (BR-W06)
  score        Int?
  answers      WeeklyAnswer[]

  @@unique([weeklyTestId, userId])
}

model WeeklyAnswer {
  attemptId     String
  attempt       WeeklyAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  order         Int
  response      Json?
  result        CheckResult?
  updatedAt     DateTime        @updatedAt @db.Timestamptz
  photos        SolutionPhoto[]
  aiReview      AiReview?
  /// Ustoz qarori (BR-W06): ball (0/1) avtomatik va AI natijasidan ustun
  teacherPoints Int?
  teacherNote   String?
  reviewedById  String?
  reviewedBy    User?           @relation("WeeklyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?       @db.Timestamptz

  @@id([attemptId, questionId])
}

/// Haftalik test savoliga yechim rasmi (1–3 ta). Rasmsiz to'g'ri javob 0 (BR-W04)
model SolutionPhoto {
  id         String       @id
  attemptId  String
  questionId String
  answer     WeeklyAnswer @relation(fields: [attemptId, questionId], references: [attemptId, questionId], onDelete: Cascade)
  /// MEDIA_DIR ichidagi nisbiy yo'l
  path       String
  bytes      Int
  createdAt  DateTime     @default(now()) @db.Timestamptz

  @@index([attemptId, questionId])
}

enum AiReviewStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// AI yechim tekshiruvi navbati (T-033). Hukm taklif xolos (BR-W06); shubha o'quvchiga ko'rsatilmaydi (BR-W05)
model AiReview {
  attemptId  String
  questionId String
  answer     WeeklyAnswer   @relation(fields: [attemptId, questionId], references: [attemptId, questionId], onDelete: Cascade)
  status     AiReviewStatus @default(PENDING)
  tries      Int            @default(0)
  /// SolutionVerdict (packages/shared/src/ai.ts)
  verdict    Json?
  /// Ko'chirishga shubha: ustoz navbatida birinchi turadi
  suspected  Boolean        @default(false)
  provider   String?
  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz
  doneAt     DateTime?      @db.Timestamptz

  @@id([attemptId, questionId])
  @@index([status, createdAt])
}

enum TutorMode {
  PRACTICE
  REVIEW
  FREE
}

enum TutorRole {
  USER
  ASSISTANT
}

/// O'quvchining AI yordamchi bilan suhbati (PLAN §7). Hammasi saqlanadi, ustoz ko'radi (BR-T04)
model TutorChat {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       TutorMode
  questionId String?
  question   Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  /// PRACTICE: TopicAttempt.id, REVIEW: WeeklyAttempt.id
  attemptId  String?
  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz
  messages   TutorMessage[]

  @@index([userId, updatedAt])
}

model TutorMessage {
  id        String    @id @default(cuid())
  chatId    String
  chat      TutorChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      TutorRole
  text      String
  /// Javob bergan provayder (ASSISTANT)
  provider  String?
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([chatId, createdAt])
}

/// Imtihon shabloni (T-050, BR-M01): bo'limlar va darajalar JSON'da, shared `examTemplateInput` bilan tekshiriladi
model ExamTemplate {
  id          String     @id @default(cuid())
  name        String
  durationMin Int
  scaleMax    Float
  sections    Json
  grades      Json
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz
  mocks       MockTest[]
}

/// Mock imtihon (T-051). `template`: yaratilgandagi shablon nusxasi, shablon keyin o'zgarsa ham natija o'zgarmaydi
model MockTest {
  id           String         @id @default(cuid())
  title        String
  templateId   String?
  examTemplate ExamTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  template     Json
  opensAt      DateTime       @db.Timestamptz
  closesAt     DateTime       @db.Timestamptz
  isPublished  Boolean        @default(false)
  /// Oyna yopilib natijalar hisoblangan vaqt
  closedAt     DateTime?      @db.Timestamptz
  /// Rasch bilan baholangan bo'lsa topshirganlar soni; null = taxminiy (BR-M05)
  raschN       Int?
  /// O'quvchilarga "mock ochildi" xabari yuborilgan vaqt (T-080)
  announcedAt  DateTime?      @db.Timestamptz
  /// Topshirmaganlarga "yopilishiga 1 kun qoldi" eslatmasi yuborilgan vaqt (T-118)
  remindedAt   DateTime?      @db.Timestamptz
  createdAt    DateTime       @default(now()) @db.Timestamptz
  questions    MockQuestion[]
  attempts     MockAttempt[]

  @@index([isPublished, closesAt])
}

model MockQuestion {
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// Shablondagi bo'lim tartib raqami (0 dan)
  section    Int
  order      Int
  /// Rasch qiyinligi (logit), yopilishda hisoblanadi
  raschB     Float?

  @@id([mockTestId, questionId])
}

/// Bitta urinish; muddat = boshlash + shablon vaqti, lekin oyna yopilishidan keyin emas (server vaqti)
model MockAttempt {
  id          String       @id @default(cuid())
  mockTestId  String
  mockTest    MockTest     @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime     @default(now()) @db.Timestamptz
  deadline    DateTime     @db.Timestamptz
  submittedAt DateTime?    @db.Timestamptz
  /// Xom ball (bo'lim ballari yig'indisi)
  raw         Float?
  /// Shkala balli: yopilishda (Rasch yoki taxminiy) qo'yiladi
  scaled      Float?
  answers     MockAnswer[]

  @@unique([mockTestId, userId])
}

model MockAnswer {
  attemptId  String
  attempt    MockAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  section    Int
  order      Int
  response   Json?
  result     CheckResult?
  updatedAt  DateTime     @updatedAt @db.Timestamptz

  @@id([attemptId, questionId])
}

/// Offline guruh (T-054): jadval matn ko'rinishida, davomat T-055 da
model Group {
  id           String           @id @default(cuid())
  name         String
  schedule     String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz
  students     StudentProfile[]
  attendance   Attendance[]
  offlineTests OfflineTest[]
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

/// Davomat (T-055): o'quvchi va kun bo'yicha bitta yozuv. Kelmagan va kechikkan uchun tasdiqlangan ota-onaga xabar
model Attendance {
  id             String            @id @default(cuid())
  groupId        String
  group          Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("Attendance", fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime          @db.Date
  status         AttendanceStatus
  note           String?
  markedById     String?
  markedBy       User?             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  /// Ota-onaga xabar qilingan holat; o'zgarsa yangi xabar ("tuzatish") boradi
  notifiedStatus AttendanceStatus?
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  @@unique([userId, date])
  @@index([groupId, date])
}

/// Tashqi (offline) test (T-056): CSV dan import, bo'limlar bo'yicha ball
model OfflineTest {
  id          String          @id @default(cuid())
  title       String
  date        DateTime        @db.Date
  groupId     String?
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sections    String[]
  createdById String?
  createdBy   User?           @relation("OfflineTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @db.Timestamptz
  results     OfflineResult[]

  @@index([date])
}

/// CSV qatori: o'quvchiga telefon yoki ism bo'yicha moslanadi, topilmasa ustoz qo'lda biriktiradi
model OfflineResult {
  id            String      @id @default(cuid())
  offlineTestId String
  offlineTest   OfflineTest @relation(fields: [offlineTestId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation("OfflineResults", fields: [userId], references: [id], onDelete: SetNull)
  line          Int
  name          String
  phone         String?
  scores        Float[]
  total         Float

  @@index([offlineTestId])
  @@index([userId])
}
