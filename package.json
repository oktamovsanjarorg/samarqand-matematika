{
  "name": "samarqand-matematika",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "pnpm --filter @samarqand/db migrate",
    "db:generate": "pnpm --filter @samarqand/db generate",
    "prepare": "husky",
    "e2e": "playwright test",
    "dev:init-data": "node --env-file=.env -r @swc-node/register scripts/dev-init-data.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@samarqand/db": "workspace:*",
    "@samarqand/shared": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.21",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
